# 국가법령정보 Open API (open.law.go.kr 신청 시 등록한 이메일의 ID 부분)
LAW_API_OC=
# 생성 (주제·사실 수집·대본·블로그·1차 점검)
GEMINI_API_KEY=
# 교차 검수·출처 대조: 현재 Claude Code 가 처리(config/models.yaml provider: claude_code) — API 로 바꿀 때만 필요
# ANTHROPIC_API_KEY=
# 링크 유입 추적기 (tracker/README.md) — 배포 후 입력
TRACKER_URL=
TRACKER_TOKEN=
# 주제 추천용 블로그 조회수 (선택, pipeline.demand) — Cloudflare API 토큰(권한: Account Analytics Read) + 계정 ID
CF_API_TOKEN=
CF_ACCOUNT_ID=
# 영상 음성: Gemini TTS 로 GEMINI_API_KEY 를 쓴다 (config/voice.yaml provider: gemini). 아래는 provider: google 일 때만 — Cloud TTS 는 API 키를 받지 않아 현재 미사용
GOOGLE_TTS_API_KEY=
# 코스 주변 피부과 목록 (선택, pipeline.clinics) — 공공데이터포털 '건강보험심사평가원_병원정보서비스' 활용신청 후 일반 인증키
DATA_GO_KR_KEY=
# X·Threads 소개 글 (pipeline/social.py)
# Threads API (무료): Meta 개발자 앱 → Threads 사용 사례 → 우리 계정을 테스터로 → 장기 토큰. 50일마다 자동 갱신(~/.skinbound/threads_token.json)
THREADS_ACCESS_TOKEN=
# X API (유료, 선택 — 기본은 작성 링크로 사람이 게시): developer.x.com 앱의 OAuth 1.0a 키 4개, channels.yaml text_social.x.mode: api
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
